# CLAUDE.md §5.7: el .env real vive fuera del control de versiones, con permisos
# restringidos en el VPS, y en CI viene de GitHub Actions Secrets.
#
# El puerto es 5433 y no el 5432 de siempre porque es habitual tener ya otro
# PostgreSQL —de otro proyecto, o instalado como servicio del sistema—
# ocupándolo. Apuntar por descuido a una base ajena y lanzar las migraciones le
# crearía esquemas que no son suyos. Lo publica el compose de desarrollo, en
# infra/docker/docker-compose.yml.
DATABASE_URL="postgresql://sgc:sgc@localhost:5433/sgc?schema=public"

# Mínimo 32 caracteres. En el VPS y en CI viene del entorno, nunca de este archivo.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# Redis: cola de generación de documentos (BullMQ, §3.4).
#
# 6380 y no el 6379 de siempre por lo mismo que el puerto de PostgreSQL: es
# habitual tener otro Redis ya levantado. Y aquí equivocarse es peor, porque
# Redis no pide credenciales — apuntar al de otro proyecto no daría error,
# encolaría trabajos en su cola y los consumiría su worker.
REDIS_URL="redis://localhost:6380"

# Dónde se guardan los documentos ya generados.
#
# En el VPS esto es un volumen de Docker; a futuro, Backblaze B2 (§5.6) sin
# tocar nada más que el adaptador. Relativa a apps/api.
DOCUMENTOS_DIR="./var/documentos"

# Saltos de proxy en los que confiar para determinar la IP del cliente.
#
# 0 en desarrollo (sin proxy). **1 en el VPS**, donde Caddy está delante: sin
# esto, Express ve la IP de Caddy en toda petición y el rate limiting de §4.4
# deja de ser por persona para pasar a ser por instalación — cinco personas
# entrando a primera hora bloquearían al resto.
#
# Es un número y no `true` a propósito: confiar sin contar los saltos permite
# falsificar `X-Forwarded-For` y saltarse el límite del login eligiendo una IP
# distinta en cada intento.
TRUST_PROXY=0

# Límite global de peticiones por minuto y por IP. Solo se sube para pruebas de
# carga; en producción se deja el valor por defecto (120).
# THROTTLE_LIMIT=120
